<?xml version="1.0" encoding="utf-8"?>  <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<!--
  编辑按键映射的对话框布局（深色美化版）

  用于 AlertDialog 的自定义视图，展示在 LayerEditActivity 点击某个手柄按键时弹出。

  布局结构（垂直 LinearLayout）:
  1. 正在编辑的按键名称（标题）
  2. 动作类型 Spinner（未设置 / 键盘按键 / 鼠标点击 / 鼠标长按 / 切换操作层）
  3. 动作值 Spinner（根据动作类型动态切换选项）
  4. 子命令区域（最多3个键盘按键选择，未设置/切换操作层时隐藏）
  5. 添加子命令按钮（子命令未满3个时显示）
-->
<!-- 语法：ScrollView 可滚动容器（对话框内容超高时可滚动）；xmlns:android 声明 android 命名空间
     layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度随内容自适应；
     maxHeight=480dp：最大高度 480dp（超出后启用滚动）；background=@drawable/bg_panel：深色面板背景 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp"
    android:background="@drawable/bg_panel">

    <!-- 语法：LinearLayout 线性布局；对话框内容垂直容器
         layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
         orientation=vertical：垂直排列；padding=20dp：内边距 20dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== 正在编辑的按键名称 ===== -->
        <!-- 语法：TextView 文本控件；显示正在编辑的手柄按键名称
             id=@+id/tv_button_name：新建按键名称文本 id（代码中动态设置）；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；textSize=18sp：字号；textStyle=bold：加粗；
             textColor=#FFFFFFFF：白色；paddingBottom=14dp：底部内边距 -->
        <TextView
            android:id="@+id/tv_button_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:paddingBottom="14dp" />

        <!-- ===== 动作类型选择 ===== -->
        <!-- 语法：TextView 文本控件；"动作类型:" 标签
             layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
             text=动作类型:：标签文字；textSize=14sp：字号；textColor=#FFDDDDDD：浅灰 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="动作类型:"
            android:textSize="14sp"
            android:textColor="#FFDDDDDD" />

        <!-- 语法：Spinner 下拉选择器控件；选择动作类型（未设置/键盘/鼠标点击/鼠标长按/切换操作层）
             id=@+id/spinner_action_type：新建动作类型选择器 id；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；paddingHorizontal=10dp：水平内边距；paddingBottom=10dp：底部内边距 -->
        <Spinner
            android:id="@+id/spinner_action_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp" />

        <!-- ===== 动作值选择（根据类型动态切换） ===== -->
        <!-- 语法：TextView 文本控件；"选择按键:" 标签
             id=@+id/tv_action_label：新建动作值标签 id（代码中动态改文字）；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；text=选择按键:：标签文字；textSize=14sp：字号；textColor=#FFDDDDDD：浅灰 -->
        <TextView
            android:id="@+id/tv_action_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择按键:"
            android:textSize="14sp"
            android:textColor="#FFDDDDDD" />

        <!-- 语法：Spinner 下拉选择器控件；选择具体动作值（如具体按键）
             id=@+id/spinner_action_value：新建动作值选择器 id；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；paddingHorizontal=10dp：水平内边距；paddingBottom=14dp：底部内边距 -->
        <Spinner
            android:id="@+id/spinner_action_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="14dp" />

        <!-- ===== 长按动作选择（可选） ===== -->
        <!-- 配置该按键的长按动作；选「未设置」= 不启用长按判定，保持原有按下即触发行为 -->
        <!-- 语法：TextView 文本控件；"长按动作（可选）:" 标签
             layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
             text=长按动作（可选）:：标签文字；textSize=14sp：字号；textColor=#FFDDDDDD：浅灰 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="长按动作（可选）:"
            android:textSize="14sp"
            android:textColor="#FFDDDDDD" />

        <!-- 语法：Spinner 下拉选择器控件；选择长按动作类型（未设置/键盘/鼠标点击/…）
             id=@+id/spinner_long_press_type：新建长按动作类型选择器 id；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；paddingHorizontal=10dp：水平内边距；paddingBottom=10dp：底部内边距 -->
        <Spinner
            android:id="@+id/spinner_long_press_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp" />

        <!-- 语法：TextView 文本控件；长按动作值标签（代码中动态改文字）
             id=@+id/tv_long_press_label：新建长按动作值标签 id；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；text=选择按键:：标签文字；textSize=14sp：字号；textColor=#FFDDDDDD：浅灰 -->
        <TextView
            android:id="@+id/tv_long_press_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择按键:"
            android:textSize="14sp"
            android:textColor="#FFDDDDDD" />

        <!-- 语法：Spinner 下拉选择器控件；选择长按动作的具体动作值
             id=@+id/spinner_long_press_value：新建长按动作值选择器 id；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；paddingHorizontal=10dp：水平内边距；paddingBottom=14dp：底部内边距 -->
        <Spinner
            android:id="@+id/spinner_long_press_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="14dp" />

        <!-- ===== 长按子命令区域 ===== -->
        <!-- 作用于「长按动作」，与短按子命令区域同构；仅长按动作为键盘按键/数字小键盘等可组合类型时显示 -->
        <!-- 语法：LinearLayout 线性布局；长按子命令区域容器
             id=@+id/layout_long_press_sub_commands：新建长按子命令容器 id（代码中控制显隐）；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；orientation=vertical：垂直排列 -->
        <LinearLayout
            android:id="@+id/layout_long_press_sub_commands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 语法：TextView 文本控件；长按子命令说明标题
                 text=长按子命令（最多3个，组合键）:：标题文字；textStyle=bold：加粗；textColor=#FFDDDDDD：浅灰；
                 paddingTop=8dp：顶部内边距；paddingBottom=8dp：底部内边距 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="长按子命令（最多3个，组合键）:"
                android:textStyle="bold"
                android:textColor="#FFDDDDDD"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- 语法：LinearLayout 线性布局；长按子命令动态容器
                 id=@+id/layout_long_press_sub_command_list：新建长按子命令列表容器 id（代码中动态添加 Spinner）；
                 layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
                 orientation=vertical：垂直排列（自闭合标签） -->
            <LinearLayout
                android:id="@+id/layout_long_press_sub_command_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 语法：Button 按钮控件；"添加长按子命令" 按钮
                 id=@+id/btn_add_long_press_sub_command：新建添加长按子命令按钮 id；layout_width=match_parent：与父容器同宽；
                 layout_height=wrap_content：高度自适应；text=+ 添加长按子命令：按钮文字；textColor=#FFFFFFFF：白色；
                 background=@drawable/bg_button：普通按钮圆角样式 -->
            <Button
                android:id="@+id/btn_add_long_press_sub_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ 添加长按子命令"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/bg_button" />
        </LinearLayout>  <!-- 结束长按子命令区域 -->

        <!-- ===== 「切层+按键」类型的附加按键区域 ===== -->
        <!-- 仅当动作类型选择「切换层+按键」时显示；用于选择切层的同时注入的键盘按键 -->
        <!-- 语法：LinearLayout 线性布局；附加按键区域容器
             id=@+id/layout_extra_key：新建附加按键区域容器 id（代码中控制显隐）；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；orientation=vertical：垂直排列（起始标签） -->
        <LinearLayout
            android:id="@+id/layout_extra_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 语法：TextView 文本控件；"同时按下的按键:" 标签
                 layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
                 text=同时按下的按键:：标签文字；textSize=14sp：字号；textColor=#FFDDDDDD：浅灰 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="同时按下的按键:"
                android:textSize="14sp"
                android:textColor="#FFDDDDDD" />

            <!-- 语法：Spinner 下拉选择器控件；选择切层时同时注入的键盘按键
                 id=@+id/spinner_extra_key：新建附加按键选择器 id；layout_width=match_parent：与父容器同宽；
                 layout_height=wrap_content：高度自适应；paddingHorizontal=10dp：水平内边距；paddingBottom=14dp：底部内边距 -->
            <Spinner
                android:id="@+id/spinner_extra_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingBottom="14dp" />
        </LinearLayout>  <!-- 结束附加按键区域 -->

        <!-- ===== 子命令区域 ===== -->
        <!-- 整个子命令容器，未设置/切换操作层类型时整体隐藏 -->
        <!-- 语法：LinearLayout 线性布局；子命令区域容器
             id=@+id/layout_sub_commands：新建子命令容器 id（代码中控制显隐）；layout_width=match_parent：与父容器同宽；
             layout_height=wrap_content：高度自适应；orientation=vertical：垂直排列 -->
        <LinearLayout
            android:id="@+id/layout_sub_commands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 语法：TextView 文本控件；子命令说明标题
                 layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
                 text=子命令（最多3个，组合键）:：标题文字；textStyle=bold：加粗；textColor=#FFDDDDDD：浅灰；
                 paddingTop=8dp：顶部内边距；paddingBottom=8dp：底部内边距 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="子命令（最多3个，组合键）:"
                android:textStyle="bold"
                android:textColor="#FFDDDDDD"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!--
              子命令动态容器
              子命令 Spinner 在代码中动态添加到此容器。
              每个子命令 Spinner 第一项为"无"（表示该位置不设子命令）。
            -->
            <!-- 语法：LinearLayout 线性布局；子命令动态容器
                 id=@+id/layout_sub_command_list：新建子命令列表容器 id（代码中动态添加 Spinner）；
                 layout_width=match_parent：与父容器同宽；layout_height=wrap_content：高度自适应；
                 orientation=vertical：垂直排列（自闭合标签） -->
            <LinearLayout
                android:id="@+id/layout_sub_command_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 添加子命令按钮（已满3个时隐藏） -->
            <!-- 语法：Button 按钮控件；"添加子命令" 按钮
                 id=@+id/btn_add_sub_command：新建添加子命令按钮 id；layout_width=match_parent：与父容器同宽；
                 layout_height=wrap_content：高度自适应；text=+ 添加子命令：按钮文字；textColor=#FFFFFFFF：白色；
                 background=@drawable/bg_button：普通按钮圆角样式 -->
            <Button
                android:id="@+id/btn_add_sub_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ 添加子命令"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/bg_button" />
        </LinearLayout>  <!-- 结束子命令区域 -->

    </LinearLayout>  <!-- 结束对话框内容垂直容器 -->
</ScrollView>  <!-- 结束 ScrollView -->
