<?xml version="1.0" encoding="utf-8"?>  <!-- XML 声明：版本 1.0，编码 UTF-8 -->
<!-- 语法：manifest 为清单根节点；xmlns:android 声明 android 命名空间（引入 android: 前缀属性的标准定义） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">  <!-- 语法：xmlns:tools 声明 tools 命名空间（供 IDE/Lint 专用属性，如 tools:ignore） -->

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />  <!-- 语法：uses-permission 声明权限；SYSTEM_ALERT_WINDOW 悬浮窗权限（游戏手柄悬浮捕获层需要） -->
    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />  <!-- 语法：FOREGROUND_SERVICE 前台服务权限（Android 9+ 启动前台服务必须） -->
    <!-- 前台服务 specialUse 类型权限 (Android 14+ 要求) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />  <!-- 语法：FOREGROUND_SERVICE_SPECIAL_USE 特殊用途前台服务权限（Android 14+ 使用 specialUse 类型必须） -->
    <!-- 网络权限 (TCP 桥接服务器) -->
    <uses-permission android:name="android.permission.INTERNET" />  <!-- 语法：INTERNET 网络访问权限（TCP 桥接服务器通信需要） -->
    <!-- 使用情况访问权限 (智能暂停: 检测前台应用自动移除/恢复焦点窗口) -->
    <!-- 语法：PACKAGE_USAGE_STATS 应用使用情况统计权限（用于检测前台应用，实现智能暂停）
         tools:ignore=ProtectedPermissions：指示 Lint 忽略该受保护权限的警告 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 写入外部存储 (导出exe到Download目录, Android 10及以下需要) -->
    <!-- 语法：WRITE_EXTERNAL_STORAGE 写外部存储权限（导出 exe 到 Download 目录）
         android:maxSdkVersion=29：仅 Android 10 及以下生效 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- 读取外部存储 (Android 10及以下需要) -->
    <!-- 语法：READ_EXTERNAL_STORAGE 读外部存储权限
         android:maxSdkVersion=32：仅 Android 12L（32）及以下生效 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 蓝牙连接权限: 查询手柄蓝牙 HID 连接状态, 准确检测手柄真实连接状态 (Android 12+) -->
    <!-- 语法：BLUETOOTH 蓝牙权限（旧版，Android 11 及以下使用）
         android:maxSdkVersion=30：仅 Android 11（30）及以下生效 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />  <!-- 语法：BLUETOOTH_CONNECT 蓝牙连接权限（Android 12+ 连接/查询蓝牙设备必须） -->

    <!-- 语法：application 节点，应用全局配置（属性对应用内所有组件生效）
         android:name=.App：应用入口 Application 类名（点开头表示相对包名自动补全）；
         android:allowBackup=true：允许系统备份应用数据到云/本地；android:icon=@mipmap/ic_launcher：应用图标；
         android:roundIcon=@mipmap/ic_launcher：圆形应用图标；android:label=SteamLikeController：应用显示名称；
         android:requestLegacyExternalStorage=true：请求旧版外部存储访问模式；android:supportsRtl=true：支持 RTL 布局；
         android:theme=@style/Theme.AppCompat.DayNight.DarkActionBar：应用默认主题 -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="SteamLikeController"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar">

        <!-- 语法：activity 节点，声明一个 Activity（界面）组件
             android:name=.MainActivity：Activity 类名；android:exported=true：可被系统作为桌面入口启动；
             android:alwaysRetainTaskState=true：任务重建时保留原有状态；android:windowSoftInputMode=adjustResize|stateHidden：软键盘模式；
             android:configChanges=orientation|screenSize|keyboard|keyboardHidden|navigation：配置变更时自行处理不重建；
             android:theme=@style/Theme.AppCompat.DayNight.NoActionBar：无 ActionBar 主题 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter>  <!-- 语法：intent-filter 意图过滤器，声明该组件能响应的 Intent 类型 -->
                <action android:name="android.intent.action.MAIN" />  <!-- 语法：action 声明动作；MAIN 表示作为应用入口主界面 -->
                <category android:name="android.intent.category.LAUNCHER" />  <!-- 语法：category 声明类别；LAUNCHER 表示出现在桌面启动器 -->
            </intent-filter>  <!-- 结束 intent-filter -->
        </activity>  <!-- 结束 MainActivity 声明 -->

        <!-- 操作层设置 Activity（内部使用，不对外暴露） -->
        <!-- 语法：activity 节点
             android:name=.LayerEditActivity：Activity 类名；android:label=操作层设置：标题显示名称；
             android:exported=false：不对外暴露；android:parentActivityName=.MainActivity：上级 Activity（提供返回导航）；
             android:theme=@style/Theme.AppCompat.DayNight.NoActionBar：无 ActionBar 主题 -->
        <activity
            android:name=".LayerEditActivity"
            android:label="操作层设置"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <!-- 使用说明 Activity（内部使用，不对外暴露） -->
        <!-- 语法：activity 节点
             android:name=.HelpActivity：Activity 类名；android:label=使用说明：标题显示名称；
             android:exported=false：不对外暴露；android:parentActivityName=.MainActivity：上级 Activity；
             android:theme=@style/Theme.AppCompat.DayNight.NoActionBar：无 ActionBar 主题 -->
        <activity
            android:name=".HelpActivity"
            android:label="使用说明"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <!-- 手柄按键测试 Activity（调试用） -->
        <!-- 语法：activity 节点
             android:name=.GamepadTestActivity：Activity 类名；android:label=手柄按键测试：标题显示名称；
             android:exported=false：不对外暴露；android:parentActivityName=.MainActivity：上级 Activity；
             android:theme=@style/Theme.AppCompat.DayNight.NoActionBar：无 ActionBar 主题 -->
        <activity
            android:name=".GamepadTestActivity"
            android:label="手柄按键测试"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <!-- 悬浮窗前台服务 -->
        <!-- 语法：service 节点，声明后台服务组件
             android:name=.service.ControllerOverlayService：服务类名；android:exported=false：不对外暴露；
             android:foregroundServiceType=specialUse：前台服务类型（Android 14+ 需声明） -->
        <service
            android:name=".service.ControllerOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- 语法：property 节点，为组件声明附加属性
                 android:name=android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE：specialUse 前台服务的子类型属性名（系统固定）；
                 android:value=游戏手柄输入映射：子类型说明（在系统设置中展示） -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="游戏手柄输入映射" />
        </service>  <!-- 结束 ControllerOverlayService 声明 -->

        <!-- 无障碍服务：暂停捕获后仍能用手柄按键恢复捕获（需用户手动开启） -->
        <!-- 语法：service 节点
             android:name=.service.GamepadAccessibilityService：无障碍服务类名；android:exported=true：需系统无障碍框架绑定；
             android:permission=android.permission.BIND_ACCESSIBILITY_SERVICE：要求调用方持有该权限；
             android:label=SteamLike手柄按键恢复：服务显示名称 -->
        <service
            android:name=".service.GamepadAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="SteamLike手柄按键恢复">
            <intent-filter>  <!-- 语法：intent-filter 意图过滤器 -->
                <action android:name="android.accessibilityservice.AccessibilityService" />  <!-- 语法：action 声明该服务为无障碍服务（系统约定动作） -->
            </intent-filter>  <!-- 结束 intent-filter -->
            <!-- 语法：meta-data 节点，为组件附加元数据（键值对）
                 android:name=android.accessibilityservice：元数据键名（系统固定）；
                 android:resource=@xml/accessibility_service_config：值为无障碍服务配置文件 -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>  <!-- 结束 GamepadAccessibilityService 声明 -->

    </application>  <!-- 结束 application 节点 -->

</manifest>  <!-- 结束 manifest 根节点 -->
